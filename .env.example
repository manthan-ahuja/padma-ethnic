# Public storefront access only. Never place an Admin API access token here.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-storefront-access-token
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-server-only-admin-token
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_API_VERSION=2026-07

# Website authentication. Keep both OAuth values server-side.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Customer carts, addresses, password accounts, and orders.
# Local development defaults to file:.data/padma.db when these are omitted.
# For deployment, use a durable libSQL/Turso database URL and token.
CUSTOMER_DATABASE_URL=file:.data/padma.db
CUSTOMER_DATABASE_AUTH_TOKEN=
